<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LicenseHub — Giriş</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="login-page">
  <div class="login-box">
    <div class="login-logo">🔑 LicenseHub</div>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <label>Şifre</label>
      <input type="password" name="password" autofocus required placeholder="Admin şifresi">
      <button type="submit">Giriş Yap</button>
    </form>
  </div>
</body>
</html>
